{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":gitSignOff",
    ":semanticCommits",
    ":semanticPrefixChore",
    ":semanticCommitScopeDisabled"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "enabledManagers": [
    "custom.regex",
    "devcontainer",
    "github-actions",
    "mise",
    "npm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Devcontainer feature versions annotated with renovate comments",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": [
        "//\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Devcontainer updates are applied on Sundays",
      "matchManagers": ["devcontainer"],
      "addLabels": ["devcontainer"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "Devcontainer feature versions are updated on Sundays, final releases only",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".devcontainer/devcontainer.json"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "addLabels": ["devcontainer"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "GitHub Actions are updated on Sundays",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "Tools pinned via mise are updated on Sundays",
      "matchManagers": ["mise"],
      "addLabels": ["mise"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "JavaScript dependencies are updated on Mondays once released for a day",
      "matchManagers": ["npm"],
      "addLabels": ["javascript"],
      "minimumReleaseAge": "1 day",
      "schedule": ["* * * * 1"]
    },
    {
      "description": "Lock file maintenance runs early on Mondays without a release age",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null,
      "schedule": ["* 0-3 * * 1"]
    },
    {
      "description": "Commitlint dependencies are grouped together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@commitlint/*"],
      "groupName": "commitlint"
    },
    {
      "description": "Tiptap overrides must match the @tiptap/vue-3 version pulled in by n8n and are updated manually",
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchPackageNames": [
        "@tiptap/extension-bubble-menu",
        "@tiptap/extension-floating-menu"
      ],
      "enabled": false
    },
    {
      "description": "The n8n-workflow override must match the version n8n depends on and is synced via `pnpm fix:n8n-workflow`",
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchPackageNames": ["n8n-workflow"],
      "enabled": false
    },
    {
      "description": "Node.js major updates are disabled",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "ESLint major updates are disabled until @n8n/node-cli supports them",
      "matchManagers": ["npm"],
      "matchPackageNames": ["eslint", "@eslint/*"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "TypeScript 7 is disabled until typescript-eslint and @n8n/node-cli support the native compiler without the JavaScript API",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
